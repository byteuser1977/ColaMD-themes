/* --------------------------------------------------------
   4. Global Styles
   -------------------------------------------------------- */
html,
body {
  font-family: var(--body-font);
  font-size: var(--base-font-size);
  line-height: var(--base-line-height);
  color: var(--text-color);
  background-color: var(--bg-color);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#write {
  max-width: var(--content-max-width);
  margin: 0 auto;
  padding: var(--content-padding);
}

/* --------------------------------------------------------
   5. Headings
   -------------------------------------------------------- */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--heading-font);
  font-weight: var(--heading-weight);
  color: var(--heading-color);
  line-height: 1.4;
  margin-top: var(--heading-margin-top);
  margin-bottom: var(--heading-margin-bottom);
}

h1 { font-size: 2em; }
h2 { font-size: 1.65em; }
h3 { font-size: 1.35em; }
h4 { font-size: 1.15em; }
h5 { font-size: 1.05em; }
h6 { font-size: 0.95em; color: var(--text-muted); }

h1:first-child,
h2:first-child,
h3:first-child { margin-top: 0; }

/* --------------------------------------------------------
   6. Paragraph & Inline Elements
   -------------------------------------------------------- */
p { margin: var(--paragraph-margin); }

strong, b { color: var(--accent-color); }
em, i { color: var(--text-muted); }
a { color: var(--accent-color); text-decoration: none; }
a:hover { text-decoration: underline; }

code {
  font-family: var(--code-font);
  font-size: 0.9em;
  background-color: var(--code-bg);
  color: var(--code-color);
  padding: 2px 6px;
  border-radius: 3px;
}

del { color: var(--text-muted); }
mark { background-color: var(--accent-light); color: var(--text-color); padding: 0 2px; }
u { text-decoration-color: var(--accent-color); }
sub, sup { font-size: 0.75em; }
kbd {
  font-family: var(--code-font);
  font-size: 0.85em;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  padding: 1px 5px;
  background-color: var(--code-bg);
}

/* --------------------------------------------------------
   7. Blockquote
   -------------------------------------------------------- */
blockquote {
  border-left: 4px solid var(--blockquote-border);
  background-color: var(--blockquote-bg);
  margin: 1.2em 0;
  padding: 0.8em 1.2em;
  color: var(--text-muted);
}

blockquote blockquote { margin-right: 0; }
blockquote p:first-child { margin-top: 0; }
blockquote p:last-child { margin-bottom: 0; }

/* --------------------------------------------------------
   8. Lists
   -------------------------------------------------------- */
ul, ol {
  margin: var(--paragraph-margin);
  padding-left: 2em;
}

li { margin: 0.3em 0; }
ul { list-style-type: disc; }
ul ul { list-style-type: circle; }
ul ul ul { list-style-type: square; }

.md-task-list-item > input[type="checkbox"] {
  margin-right: 0.5em;
  accent-color: var(--accent-color);
}

/* --------------------------------------------------------
   9. Code Blocks (Fenced)
   -------------------------------------------------------- */
pre.md-fences,
pre.CodeMirror-line {
  font-family: var(--code-font);
  font-size: 0.9em;
  background-color: var(--code-block-bg);
  color: var(--code-block-text);
  border-radius: 6px;
  padding: 1em 1.2em;
  margin: 1.2em 0;
  overflow-x: auto;
  line-height: 1.6;
}

.md-fences .code-tooltip {
  background-color: var(--code-block-bg);
  color: var(--code-block-text);
}

h1 code, h2 code, h3 code, h4 code, h5 code, h6 code {
  font-size: inherit;
  background-color: var(--code-bg);
}

/* --------------------------------------------------------
   10. Tables
   -------------------------------------------------------- */
table {
  border-collapse: collapse;
  width: 100%;
  margin: 1.2em 0;
  font-size: 0.95em;
}

th, td {
  border: 1px solid var(--border-color);
  padding: 0.6em 1em;
  text-align: left;
}

th {
  background-color: var(--table-header-bg);
  font-weight: var(--heading-weight);
  color: var(--heading-color);
}

tr:nth-child(even) td {
  background-color: {{lighten palette.tableHeaderBg 0.03}};
}

/* --------------------------------------------------------
   11. Horizontal Rules
   -------------------------------------------------------- */
hr {
  border: none;
  border-top: 1px solid var(--border-color);
  margin: 2em 0;
}

/* --------------------------------------------------------
   12. Images
   -------------------------------------------------------- */
img {
  max-width: 100%;
  border-radius: 4px;
}

/* --------------------------------------------------------
   13. Footnotes
   -------------------------------------------------------- */
.footnotes {
  font-size: 0.9em;
  color: var(--text-muted);
  border-top: 1px solid var(--border-color);
  margin-top: 2em;
  padding-top: 1em;
}

.footnotes a { color: var(--accent-color); }

/* --------------------------------------------------------
   14. Table of Contents
   -------------------------------------------------------- */
.md-toc {
  font-size: 0.95em;
  margin: 1em 0;
}

.md-toc a { color: var(--text-color); }
.md-toc a:hover { color: var(--accent-color); }

/* --------------------------------------------------------
   15. Math Blocks
   -------------------------------------------------------- */
.md-math-block,
.md-rawblock {
  font-family: var(--code-font);
  color: var(--text-color);
  background-color: var(--code-bg);
  padding: 0.8em 1em;
  border-radius: 4px;
  margin: 1em 0;
}

/* --------------------------------------------------------
   16. Metadata / YAML Frontmatter
   -------------------------------------------------------- */
pre.md-meta-block {
  font-family: var(--code-font);
  font-size: 0.85em;
  background-color: var(--code-bg);
  color: var(--text-muted);
  border-bottom: 1px solid var(--border-color);
  padding: 1em 1.2em;
  margin: 0 0 1.5em 0;
  border-radius: 4px;
}

/* --------------------------------------------------------
   17. Scrollbar
   -------------------------------------------------------- */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background-color: {{darken palette.borderColor 0.15}};
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background-color: {{darken palette.borderColor 0.3}};
}

/* --------------------------------------------------------
   18. Selection
   -------------------------------------------------------- */
::selection {
  background-color: var(--selection-bg);
  color: var(--select-text-font-color);
}

::-moz-selection {
  background-color: var(--selection-bg);
  color: var(--select-text-font-color);
}

/* --------------------------------------------------------
   19. Source Code Mode
   -------------------------------------------------------- */
#typora-source .CodeMirror-lines {
  max-width: var(--content-max-width);
  margin: 0 auto;
}

.CodeMirror {
  font-family: var(--code-font);
  font-size: 0.9em;
  line-height: 1.6;
}

.CodeMirror-gutters {
  background-color: var(--bg-color);
  border-right: 1px solid var(--border-color);
}

.CodeMirror-linenumber { color: var(--text-muted); }

.cm-s-inner .cm-keyword { color: {{ syntax.keyword }}; }
.cm-s-inner .cm-atom { color: {{ syntax.booleanBuiltinTag }}; }
.cm-s-inner .cm-number { color: {{ syntax.number }}; }
.cm-s-inner .cm-def { color: {{ syntax.functionClass }}; }
.cm-s-inner .cm-variable { color: {{ syntax.variable }}; }
.cm-s-inner .cm-variable-2 { color: {{ syntax.functionClass }}; }
.cm-s-inner .cm-property { color: {{ syntax.variable }}; }
.cm-s-inner .cm-operator { color: {{ syntax.operator }}; }
.cm-s-inner .cm-comment { color: {{ syntax.comment }}; }
.cm-s-inner .cm-string { color: {{ syntax.string }}; }
.cm-s-inner .cm-string-2 { color: {{ syntax.string }}; }
.cm-s-inner .cm-tag { color: {{ syntax.booleanBuiltinTag }}; }
.cm-s-inner .cm-meta { color: {{ syntax.variable }}; }
.cm-s-inner .cm-qualifier { color: {{ syntax.keyword }}; }
.cm-s-inner .cm-builtin { color: {{ syntax.booleanBuiltinTag }}; }
.cm-s-inner .cm-bracket { color: {{ syntax.punctuation }}; }
.cm-s-inner .cm-link { color: {{ syntax.functionClass }}; }
.cm-s-inner .cm-attribute { color: {{ syntax.functionClass }}; }
.cm-s-inner .cm-hr { color: {{ syntax.punctuation }}; }
.cm-s-inner .cm-error { color: {{ syntax.regex }}; }

/* --------------------------------------------------------
   20. Syntax Highlighting (Prism / CodeMirror adaptation)
   -------------------------------------------------------- */
.token.comment,
.token.prolog,
.token.doctype,
.token.cdata { color: {{ syntax.comment }}; }

.token.punctuation { color: {{ syntax.punctuation }}; }

.token.property,
.token.tag,
.token.boolean,
.token.number,
.token.constant,
.token.symbol,
.token.deleted { color: {{ syntax.booleanBuiltinTag }}; }

.token.selector,
.token.attr-name,
.token.string,
.token.char,
.token.builtin,
.token.inserted { color: {{ syntax.string }}; }

.token.operator,
.token.entity,
.token.url { color: {{ syntax.operator }}; }

.token.atrule,
.token.attr-value,
.token.keyword { color: {{ syntax.keyword }}; }

.token.function,
.token.class-name { color: {{ syntax.functionClass }}; }

.token.regex,
.token.important,
.token.variable { color: {{ syntax.regex }}; }

/* --------------------------------------------------------
   21. Mermaid Diagrams
   -------------------------------------------------------- */
pre.md-diagram-panel {
  font-family: var(--mermaid-font-family);
  font-size: var(--mermaid-font-size);
}

/* --------------------------------------------------------
   22. Diagrams (Sequence, Flowchart)
   -------------------------------------------------------- */
.md-diagram-panel .actor {
  stroke: var(--accent-color);
  fill: var(--bg-color);
}

.md-diagram-panel .text.actor > tspan {
  fill: var(--text-color);
}

.md-diagram-panel .messageLine0,
.md-diagram-panel .messageLine1 {
  stroke: var(--border-color);
}

.md-diagram-panel .labelBox {
  stroke: var(--accent-color);
  fill: var(--bg-color);
}

.md-diagram-panel .labelText,
.md-diagram-panel .labelText > tspan {
  fill: var(--text-color);
}

/* --------------------------------------------------------
   23. Print Styles
   -------------------------------------------------------- */
@media print {
  html, body {
    font-size: 12pt;
    color: #000;
    background: #fff;
  }
  #write { max-width: 100%; padding: 0; }
  a { color: #000; }
  pre.md-fences { background: #f5f5f5; border: 1px solid #ccc; }
  code { background: #f5f5f5; }
}

/* --------------------------------------------------------
   24. Mobile Responsive
   -------------------------------------------------------- */
@media screen and (max-width: 768px) {
  #write { padding: 20px 16px 60px; }
  table { font-size: 0.85em; }
  th, td { padding: 0.4em 0.6em; }
  h1 { font-size: 1.6em; }
  h2 { font-size: 1.35em; }
  h3 { font-size: 1.15em; }
}
