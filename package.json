{
  "name": "@bytechain.cn/colamd-themes",
  "version": "0.3.1",
  "description": "Theme development & export tool for ColaMD — extract formatting, generate themes, and export Markdown to HTML/PDF",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "colamd-themes": "./dist/cli.js",
    "cthemes": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node --input-type=commonjs -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\"",
    "build:skills": "bash skills/build-skills.sh",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@bytechain.cn/colamd": "^1.5.2",
    "axios": "^1.7",
    "chalk": "^5.3",
    "cheerio": "^1.0",
    "commander": "^12.0",
    "css-tree": "^3.0",
    "handlebars": "^4.7",
    "mammoth": "^1.8",
    "ora": "^8.0",
    "pdf-parse": "^1.1",
    "puppeteer": "^24.0"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3",
    "@types/node": "^22.0",
    "tsx": "^4.0",
    "typescript": "^5.5"
  }
}
