{
  "name": "@bytechain.cn/colamd-themes",
  "version": "0.5.6",
  "description": "Theme development & export tool for ColaMD — extract formatting, generate themes, and export Markdown to HTML/PDF",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byteuser1977/ColaMD-themes.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "colamd-themes": "./dist/cli.js",
    "cthemes": "./dist/cli.js",
    "colamd-themes-mcp": "./mcp-server/dist/index.js"
  },
  "scripts": {
    "build": "tsc && node --input-type=commonjs -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\"",
    "build:skills": "node skills/build-skills.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "build:mcp": "cd mcp-server && npm run build",
    "build:all": "npm run build && npm run build:mcp",
    "mcp": "node mcp-server/dist/index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "colamd",
    "themes",
    "css",
    "markdown",
    "pdf",
    "html",
    "skill",
    "ai-agent",
    "agent-skill"
  ],
  "files": [
    "dist",
    "themes",
    "skills",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.1 || ^0.2.0-rc || ^0.2.1-rc || ^0.3.0-rc || ^0.4.0-rc"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "dependencies": {
    "@bytechain.cn/colamd": "^2.7.11",
    "axios": "^1.7",
    "chalk": "^5.3",
    "cheerio": "^1.0",
    "commander": "^12.0",
    "css-tree": "^3.0",
    "handlebars": "^4.7",
    "mammoth": "^1.8",
    "ora": "^8.0",
    "pdf-parse": "^1.1",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^24.0"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3",
    "@types/node": "^22.0",
    "tsx": "^4.0",
    "typescript": "^5.5"
  }
}
